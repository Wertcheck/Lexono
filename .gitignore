# Secrets / lokale Konfiguration
.env
.env.*
!.env.example
!.env.gateway.example
*.local.env
.claude/launch.json

# Lexono-Gateway (ARCHITECTURE.md §70) - eigene lokale Datenbank/Daten,
# niemals Teil des Repos (enthaelt Kanzlei-Credential-Hashes).
/gateway_data/

# Laufzeit-Logs (Schritt 3, Start.vbs) - koennen technische Details/
# Stacktraces enthalten, gehoeren nicht ins Repo.
app.log
*.log

# Mandanten-/Aktendaten (duerfen nie ins Repo)
/data/
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
# Gebuendelte Installer-Artefakte (.exe) - Build-Ausgabe, kein Quellcode,
# jederzeit per windows/build.ps1 aus dem Quellcode neu erzeugbar (Prompt 47).
INSTALLER/

# Gebuendeltes Tesseract-OCR (~70 MB Binaerdaten) - wie das spaCy-Modell/
# Embedding-Modell bewusst NICHT im Repo, sondern jederzeit per
# windows/fetch_tesseract.ps1 neu erzeugbar (siehe dort). windows/kanzlei_ai.spec
# bricht den Build mit einer klaren Fehlermeldung ab, falls dieser Ordner beim
# Erzeugen des Installers fehlt.
windows/vendor/
build_tools/

# Virtuelle Umgebungen
.venv/
venv/

# Editor/OS
.vscode/
.idea/
.DS_Store
