# Beispielkonfiguration fuer den Lexono-Gateway (ARCHITECTURE.md §70) -
# NIEMALS echte Secrets in diese Datei oder ins Repo eintragen.
# Kopieren nach ".env.gateway" (im Arbeitsverzeichnis des Gateway-Prozesses)
# und dort mit echten Werten befuellen. ".env.gateway" ist in .gitignore.
#
# WICHTIG: Dies ist die Konfiguration des SERVERS, nicht der Kanzlei-
# Anwendung - läuft in einem komplett getrennten Prozess/Verzeichnis, nie
# zusammen mit einer Kanzlei-Installation. Der hier eingetragene
# ANTHROPIC_API_KEY ist der ECHTE, produktiv genutzte Schluessel.

# --- Anthropic (der einzige Ort, an dem dieser Wert produktiv existiert) ---
# ANTHROPIC_API_KEY=

# --- Zentrale Modellsteuerung (Umsetzungsplan Punkt 1) ---
# Das vom Client mitgesendete Modell wird weiterhin gegen ALLOWED_MODELS
# geprueft, bestimmt aber NICHT mehr die tatsaechliche Modellwahl - das ist
# ausschliesslich DEFAULT_MODEL. Ein Modellwechsel ist damit eine reine
# Aenderung dieses Werts + Prozess-Neustart, kein Client-Rebuild noetig.
# DEFAULT_MODEL muss in ALLOWED_MODELS enthalten sein (wird beim Start
# geprueft).
DEFAULT_MODEL=claude-sonnet-5
ALLOWED_MODELS=["claude-sonnet-5", "claude-opus-4-8"]

# --- Kostenkontrolle / Abuse-Schutz ---
MAX_TOKENS_CEILING=4000
# Groessenlimit fuer den Eingabe-Payload in Bytes (system+messages,
# serialisiert) - zweite, feinere Schutzschicht zusaetzlich zum
# Reverse-Proxy-Bodylimit (siehe deploy/Caddyfile).
MAX_REQUEST_BYTES=200000
DEFAULT_RATE_LIMIT_PER_MINUTE=30

# --- Eigene Datenbank (Kanzlei-Credentials, keine Mandantendaten) ---
DATABASE_URL=sqlite:///./gateway_data/gateway.db

# --- Netzwerk ---
HOST=127.0.0.1
PORT=8700

LOG_LEVEL=INFO
